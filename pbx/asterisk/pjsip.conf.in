; pjsip.conf — ReJack home PBX (rendered by pbx/install.sh; @...@ = from pbx/secrets.env)
; Extensions: 100 = ReJack (magicJack + analog phone), 101 = Linphone (cell), 102 = PC softphone.
; Reachable only from localhost and the LAN (acl below). Never port-forward 5060.

[global]
type=global
user_agent=ReJack PBX
endpoint_identifier_order=ip,username   ; the trunk by IP first, so a caller ID like "100" can't match an extension

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[acl-home]
type=acl
deny=0.0.0.0/0.0.0.0
permit=127.0.0.1/255.255.255.255
permit=@LAN_CIDR@
permit=@TRUNK_PERMIT@   ; the SIP trunk provider's server (localhost again when there is no trunk)

; ---- templates ----
[endpoint-tpl](!)
type=endpoint
transport=transport-udp          ; house phones on 5060; the trunk has its own transport
context=rejack-phones
disallow=all
allow=ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
language=en

[auth-tpl](!)
type=auth
auth_type=userpass

[aor-tpl](!)
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

; ---- 100: ReJack ----
[100](endpoint-tpl)
auth=100
aors=100
callerid="Home Phone" <100>
[100](auth-tpl)
username=100
password=@PW_100@
[100](aor-tpl)
mailboxes=100@default

; ---- 101: Linphone on the cell ----
[101](endpoint-tpl)
auth=101
aors=101
callerid="Cell" <101>
[101](auth-tpl)
username=101
password=@PW_101@
[101](aor-tpl)
mailboxes=101@default

; ---- 102: PC softphone ----
[102](endpoint-tpl)
auth=102
aors=102
callerid="PC" <102>
[102](auth-tpl)
username=102
password=@PW_102@
[102](aor-tpl)
mailboxes=102@default

; ---- SIP trunk (empty file when TRUNK_HOST is not set) ----
#tryinclude pjsip_trunk.conf
