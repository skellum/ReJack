# pbx/secrets.env — generated by pbx/install.sh on first run (gitignored). One password per extension.
LAN_CIDR=192.168.1.0/255.255.255.0
PW_100=change-me
PW_101=change-me
PW_102=change-me
VM_PIN_100=000000
VM_PIN_101=000000
VM_PIN_102=000000
# SIP trunk (optional; leave TRUNK_HOST empty for none). Password in single quotes; avoid | & \ ; # and spaces.
TRUNK_HOST=
TRUNK_USER=
TRUNK_PASS=''
TRUNK_DID=
TRUNK_PORT=              # provider's SIP port (default 5060; use an alternate one if calls get no reply)
TRUNK_LOCAL_PORT=        # this server's trunk port (default 5160)
