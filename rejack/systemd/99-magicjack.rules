# /etc/udev/rules.d/99-magicjack.rules — installed by rejack/systemd/install.sh
# HID control node for the audio group, as a stable name.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="06e6", ATTRS{idProduct}=="c200", MODE="0660", GROUP="audio", SYMLINK+="magicjack-hid"
# Desktop sound servers keep their hands off the phone line: PulseAudio honours PULSE_IGNORE, PipeWire's ACP
# ACP_IGNORE. (A PulseAudio running for another account held the card open, which also blocks driver reloads.)
SUBSYSTEM=="sound", ATTRS{idVendor}=="06e6", ATTRS{idProduct}=="c200", ENV{PULSE_IGNORE}="1", ENV{ACP_IGNORE}="1"
# Line levels, on every plug-in (the card powers up at capture 8, playback 0, both 0..15 dB).
# Capture 15 = phone -> network loud enough for voicemail's silence detection; playback 8 = network -> phone.
SUBSYSTEM=="sound", KERNEL=="controlC*", ACTION=="add|change", ATTRS{idVendor}=="06e6", ATTRS{idProduct}=="c200", \
  RUN+="/usr/bin/amixer -q -c %n cset name='Headset Capture Volume' 15", \
  RUN+="/usr/bin/amixer -q -c %n cset name='PCM Playback Volume' 8"
# The dongle's built-in flash (vendor installer, 18 MB, mass-storage interface 0) is never used. With it bound,
# usb-storage error handling reset the whole device (2026-11-23, 3 resets in a night), which breaks the audio
# stream. Deauthorize just that interface; hook, audio and HID are untouched.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="06e6", ATTRS{idProduct}=="c200", \
  ATTR{bInterfaceClass}=="08", ATTR{authorized}="0"
