# Rejack emergency notifications — copy to /etc/rejack/emergency.env (chmod 600) and fill in.
# Used by scripts/rejack-emergency. Never commit the filled-in copy.

REJACK_PHONE_NAME="Home phone"

# --- ntfy (push to your phone via the ntfy app) -------------------------------------------
# Anyone who knows the topic name can read AND post to it on ntfy.sh — use a long random name,
# e.g.  openssl rand -hex 12   ->  https://ntfy.sh/rejack-<that>
# Subscribe to the same URL in the ntfy app (Android/iOS). Alerts are sent with priority "urgent".
NTFY_URL=https://ntfy.sh/rejack-CHANGE-ME-TO-A-RANDOM-STRING

# --- Telegram (text + the recording as an audio message) -----------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
# 2. Send any message to your new bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy "chat":{"id": ... } — that number is TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Not used yet ----------------------------------------------------------------------------
#DISCORD_WEBHOOK_URL=
#EMAIL_TO=

# --- Paths (defaults shown) ------------------------------------------------------------------
#REJACK_OUTBOX=/var/lib/rejack/outbox
#REJACK_EMERGENCY_LOG=/var/lib/rejack/emergency.log
